<resources>
    <!-- Theme for Vibecraft app -->
    <style name="Theme.Vibecraft" parent="Theme.Material3.DayNight">
        <!-- Primary and accent colors -->
        <item name="colorPrimary">#2E8B57</item> <!-- Forest Green -->
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#B5EAD7</item>
        <item name="colorSecondary">#388E3C</item> <!-- Darker Green -->
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Background and surface colors -->
        <item name="colorBackground">#FFFFFF</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <!-- Optional: Remove default action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
