<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground for the adaptive launcher icon.
    Shows a simple white calculator silhouette with gold accent bars,
    matching the app's green‑white‑gold theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Calculator body: white rounded square (squircle approximation) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,24
            h60
            a12,12 0 0 1 12,12
            v36
            a12,12 0 0 1 -12,12
            h-60
            a12,12 0 0 1 -12,-12
            v-36
            a12,12 0 0 1 12,-12
            z" />

    <!-- Gold display bar at the top of the calculator -->
    <path
        android:fillColor="#FFD9B45C"
        android:pathData="M30,30 h48 v8 h-48 z" />

    <!-- Gold accent circle at the bottom‑right corner (e.g., power button) -->
    <path
        android:fillColor="#FFD9B45C"
        android:pathData="M84,84
            a6,6 0 0 1 -12,0
            a6,6 0 0 1 12,0" />
</vector>
